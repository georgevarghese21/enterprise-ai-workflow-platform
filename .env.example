# Copy to .env and adjust as needed. Docker Compose already sets sane
# defaults for the backend service; this file matters mainly for running
# the backend outside Docker (e.g. `uvicorn app.main:app` directly).

DATABASE_URL=postgresql+psycopg://novatech:novatech@localhost:5432/novatech

# mock (no external calls, deterministic responses) | anthropic | openai
LLM_MODE=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

EMBEDDING_PROVIDER=mock

LOG_LEVEL=INFO
