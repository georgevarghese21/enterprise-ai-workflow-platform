# Copy to .env and adjust as needed. Docker Compose already sets sane
# defaults for the backend service; this file matters mainly for running
# the backend outside Docker (e.g. `uvicorn app.main:app` directly).

DATABASE_URL=postgresql+psycopg://novatech:novatech@localhost:5432/novatech

# mock (no external calls, deterministic responses) | anthropic | ollama | groq |
# cascade (mock first; only calls Groq when the mock's own confidence is low -
# needs GROQ_API_KEY set even though it's mostly free)
LLM_MODE=mock
ANTHROPIC_API_KEY=

# Ollama runs locally and is free (no API key needed). Requires Ollama
# installed and running (`ollama pull llama3.2` first). docker-compose.yml
# overrides OLLAMA_BASE_URL to reach the host from inside the container.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq's free tier (console.groq.com) needs no credit card and doesn't
# expire; serves much larger hosted open-weight models than anything
# practical to run locally (see GROQ_MODEL in app/services/llm_provider.py -
# Groq's model lineup changes over time, check their /models endpoint).
GROQ_API_KEY=

OPENAI_API_KEY=

EMBEDDING_PROVIDER=mock

LOG_LEVEL=INFO
